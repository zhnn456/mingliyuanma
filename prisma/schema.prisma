// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// 核心原则：所有数据模型在此定义，其他层从此派生
// ============================================

/// 用户表 - 所有角色共用
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  phone         String?
  avatar        String?
  role          String    @default("user") // user, agent, admin
  memberLevel   String    @default("basic")
  memberExpiryAt DateTime?
  agentId       String?   // 如果是代理商用户，关联代理商
  
  // 关系
  agent         Agent?    @relation
  orders        Order[]
  tickets       Ticket[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([email])
  @@index([role])
  @@index([agentId])
}

/// 代理商表 - 所有代理商信息
model Agent {
  id              String    @id @default(cuid())
  userId          String    @unique // 关联用户账号
  companyName     String?
  contactName     String
  contactPhone    String
  domain          String?   @unique // 绑定域名
  brandName       String?
  logo            String?
  licenseKey      String?   // 当前生效的授权码
  licenseExpiry   DateTime?
  siteConfig      String?   // JSON 格式的站点配置

  // 代理商等级与套餐
  level           String?   @default("saas") // saas（一级 SaaS 代理）| source（二级源码代理）
  plan            String?   @default("trial") // trial | monthly | annual | lifetime
  planExpiry      DateTime? // 套餐到期时间
  referralCode    String?   @unique // 邀请码（REF 开头）
  maxCustomers    Int       @default(500) // 最大客户数

  // 佣金与结算
  commissionRate    Float   @default(0.3) // 佣金比例
  totalCommission   Float   @default(0) // 累计佣金
  pendingCommission Float   @default(0) // 待结算佣金
  currentMonthGMV   Float   @default(0) // 当月 GMV
  settlementCycle   String? @default("weekly") // weekly | monthly
  balance           Float   @default(0) // 账户余额

  // 收款信息
  bankName        String?
  bankAccount     String?
  bankAccountName String?

  // 同步状态
  lastSyncAt      DateTime?
  lastVersion     String?
  systemStatus    String?   @default("online")

  // 关系
  user            User      @relation(fields: [userId], references: [id])
  licenses        AgentLicense[]
  settlements     Settlement[]
  commissionRecords CommissionRecord[]

  isActive        Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([domain])
  @@index([isActive])
  @@index([referralCode])
  @@index([level])
}

/// 授权码表 - 代理商授权管理
model AgentLicense {
  id          String    @id @default(cuid())
  agentId     String
  licenseKey  String    @unique
  domain      String?
  maxUsers    Int       @default(1000)
  expiryAt    DateTime?
  features    String?   // JSON 格式的功能权限
  status      String    @default("active") // active, expired, revoked
  signature   String?   // HMAC 签名
  
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([agentId])
  @@index([licenseKey])
  @@index([status])
}

/// 订单表 - 所有交易记录
model Order {
  id          String    @id @default(cuid())
  userId      String
  type        String    // membership, recharge, report
  amount      Float
  status      String    @default("pending") // pending, paid, cancelled, refunded
  orderData   String?   // JSON 格式的订单详情
  
  user        User      @relation(fields: [userId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([type])
}

/// 结算表 - 代理商结算
model Settlement {
  id          String    @id @default(cuid())
  agentId     String
  period      String    // 2024-01
  amount      Float
  status      String    @default("pending") // pending, approved, paid
  note        String?
  
  agent       Agent     @relation(fields: [agentId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([agentId])
  @@index([status])
}

/// 分润记录表
model CommissionRecord {
  id              String    @id @default(cuid())
  agentId         String
  orderId         String
  orderAmount     Float
  commissionRate  Float
  commissionAmount Float
  status          String    @default("pending")
  period          String?
  
  agent           Agent     @relation(fields: [agentId], references: [id])
  
  createdAt       DateTime  @default(now())
  
  @@index([agentId])
  @@index([orderId])
}

/// 工单表
model Ticket {
  id          String    @id @default(cuid())
  userId      String
  title       String
  content     String
  status      String    @default("open")
  priority    String    @default("normal")
  
  user        User      @relation(fields: [userId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
}

/// 更新日志表 - 记录系统版本更新和变更内容
model UpdateLog {
  id          String    @id @default(cuid())
  version     String    // 版本号，如 v4.0.0
  title       String    // 更新标题
  content     String    // 更新内容描述（支持 Markdown 或纯文本）
  type        String    @default("update") // update, feature, fix, security
  isMajor     Boolean   @default(false) // 是否为重大更新
  changes     String?   // JSON 格式的变更列表
  operatorId  String?   // 操作人ID
  operatorName String?  // 操作人名称
  tag         String?   // Git tag 或部署 ID
  status      String    @default("success") // success, failed, rolled_back
  rollbackVersion String? // 回滚目标版本
  
  createdAt   DateTime  @default(now())
  
  @@index([version])
  @@index([type])
  @@index([createdAt])
  @@index([status])
}