generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Agent {
  id            String    @id
  userId        String    @unique
  companyName   String?
  contactName   String?
  contactPhone  String?
  domain        String?   @unique
  brandName     String?
  logo          String?
  siteConfig    String?
  licenseKey    String?   @unique
  licenseExpiry DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
}

model AgentLicense {
  id         String    @id
  agentId    String
  licenseKey String    @unique
  domain     String?   @unique
  issuedAt   DateTime  @default(now())
  expiryAt   DateTime?
  maxUsers   Int?
  features   String?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
}

model BaziRecord {
  id             String   @id
  userId         String
  name           String?
  gender         String
  birthDate      String
  birthTime      String
  isLunar        Boolean  @default(false)
  yearGan        String
  yearZhi        String
  monthGan       String
  monthZhi       String
  dayGan         String
  dayZhi         String
  hourGan        String
  hourZhi        String
  wuxing         String?
  dayun          String?
  liunian        String?
  interpretation String?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])
}

model DivinationRule {
  id            String   @id
  category      String
  ruleType      String
  ruleKey       String
  subKey        String?
  content       String
  classicSource String?
  classicQuote  String?
  priority      Int      @default(0)
  agentId       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@unique([category, ruleType, ruleKey, subKey, agentId])
  @@index([category, ruleType, agentId])
}

model MeihuaRecord {
  id             String   @id
  userId         String
  method         String
  input          String
  upperGua       String
  lowerGua       String
  dongYao        Int
  benGua         String?
  huGua          String?
  bianGua        String?
  tiYong         String?
  interpretation String?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])
}

model MembershipPlan {
  id          String   @id
  name        String
  level       String   @unique
  price       Float
  duration    Int?
  description String?
  features    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model OfferingCategory {
  id           String         @id
  name         String
  icon         String?
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)
  OfferingItem OfferingItem[]
}

model OfferingItem {
  id               String           @id
  categoryId       String
  name             String
  image            String?
  description      String?
  priceSingle      Float?
  priceMonth       Float?
  priceYear        Float?
  isActive         Boolean          @default(true)
  sortOrder        Int              @default(0)
  OfferingCategory OfferingCategory @relation(fields: [categoryId], references: [id])
  OfferingRecord   OfferingRecord[]
}

model OfferingRecord {
  id           String       @id
  userId       String
  itemId       String
  supplyIds    String?
  amount       Float
  type         String
  startDate    DateTime     @default(now())
  endDate      DateTime?
  status       String       @default("active")
  createdAt    DateTime     @default(now())
  OfferingItem OfferingItem @relation(fields: [itemId], references: [id])
  User         User         @relation(fields: [userId], references: [id])
}

model OfferingSupply {
  id          String   @id
  name        String
  icon        String?
  image       String?
  price       Float
  description String?
  category    String   @default("general")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  stock       Int      @default(0)
}

model Order {
  id            String    @id
  orderNo       String    @unique
  userId        String
  type          String
  targetId      String?
  amount        Float
  status        String    @default("pending")
  paymentMethod String?
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  User          User      @relation(fields: [userId], references: [id])
}

model Payment {
  id            String    @id
  orderId       String    @unique
  userId        String
  method        String
  amount        Float
  status        String    @default("pending")
  transactionId String?
  paidAt        DateTime?
  refundAt      DateTime?
  refundAmount  Float?
  remark        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
}

model QimenRecord {
  id             String   @id
  userId         String
  queryTime      String
  dunType        String
  juNumber       Int
  tianPan        String?
  diPan          String?
  renPan         String?
  shenPan        String?
  interpretation String?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteConfig {
  id        String   @id
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime
}

model User {
  id             String           @id
  email          String?          @unique
  phone          String?          @unique
  name           String?
  passwordHash   String?
  avatar         String?
  role           String           @default("user")
  memberLevel    String           @default("free")
  memberExpiry   DateTime?
  dailyUsage     Int              @default(0)
  lastUsageDate  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Account        Account[]
  BaziRecord     BaziRecord[]
  MeihuaRecord   MeihuaRecord[]
  OfferingRecord OfferingRecord[]
  Order          Order[]
  QimenRecord    QimenRecord[]
  Session        Session[]
  ZiweiRecord    ZiweiRecord[]
}

model ExportTask {
  id         String   @id
  type       String
  format     String   @default("csv")
  status     String   @default("pending")
  fileUrl    String?
  params     String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([status])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ZiweiRecord {
  id             String   @id
  userId         String
  name           String?
  gender         String
  birthDate      String
  birthTime      String
  isLunar        Boolean  @default(false)
  mingGong       String?
  palaceData     String?
  starData       String?
  sihuaData      String?
  interpretation String?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])
}
