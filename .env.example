# ============================================
# 命理网站 - 环境变量配置模板
# ============================================

# 数据库连接
# 开发环境使用 SQLite
DATABASE_URL="file:./dev.db"
# 生产环境使用 PostgreSQL (示例)
# DATABASE_URL="postgresql://user:password@localhost:5432/mingli?schema=public"

# NextAuth 认证配置
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# 站点基本信息
SITE_NAME="命理网"
SITE_DESCRIPTION="专业命理测算平台"
SITE_LOGO="/logo.png"

# 服务端口
PORT=3000

# Nginx 端口 (Docker 部署时)
NGINX_PORT=80

# 代理商 ID (多代理商部署时区分)
AGENT_ID="default"

# ============================================
# 支付配置 (接入支付时填写)
# ============================================
# 微信支付
# WECHAT_PAY_APPID=
# WECHAT_PAY_MCHID=
# WECHAT_PAY_API_KEY=
# WECHAT_PAY_CERT_PATH=

# 支付宝
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# ============================================
# 存储配置 (可选)
# ============================================
# 阿里云 OSS
# OSS_REGION=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=

# 或 MinIO (自部署)
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=

# ============================================
# Cloudflare Pages 部署配置
# ============================================
# 在 Cloudflare Dashboard 中设置，不要写在这里
# CF_PAGES=1                                    # CF 自动注入
# NEXTAUTH_URL=https://你的域名.com              # Dashboard 环境变量
# NEXTAUTH_SECRET=随机密钥                       # Dashboard secret 或 wrangler secret put
# D1 数据库和 KV 通过 Dashboard 绑定，不需要 URL

# ============================================
# Redis 缓存 (可选，生产环境推荐)
# ============================================
# REDIS_URL="redis://localhost:6379"

# ============================================
# 邮件配置 (可选)
# ============================================
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
