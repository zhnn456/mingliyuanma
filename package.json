{
  "name": "mingli-source",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "build:pages": "npx @cloudflare/next-on-pages",
    "preview:pages": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "deploy:pages": "npx wrangler pages deploy .vercel/output/static",
    "db:migrate:d1": "npx wrangler d1 execute yuanmamingli --remote --file=prisma/migrations.sql",
    "db:migrate:d1:local": "npx wrangler d1 execute yuanmamingli --local --file=prisma/migrations.sql"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "3meta": "^2.6.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.6.12",
    "next": "^14.2.0",
    "next-auth": "^4.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@prisma/adapter-d1": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
